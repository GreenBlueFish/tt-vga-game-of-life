flowchart TB
    %% ===== Chip pins =====
    CLK([clk 25.175 MHz]):::pin
    RSTN([rst_n]):::pin
    UIIN([ui_in 7:0]):::pin
    UOOUT([uo_out 7:0 - TinyVGA Pmod]):::pin

    subgraph TOP["tt_um_vga_interface (project.v)"]
        direction TB

        %% ----- control decode -----
        DEC["control decode<br/>step = ui_in 7<br/>run = ui_in 6 (unused)<br/>load_en = ui_in 5<br/>load_data = ui_in 4<br/>speed = ui_in 1:0"]:::glue
        RST["reset = ~rst_n"]:::glue

        %% ----- VGA timing -----
        subgraph VT["u_timing : vga_timing.v"]
            direction TB
            HCNT["h counter -> hpos 9:0"]:::logic
            VCNT["v counter -> vpos 9:0"]:::logic
            SYNC["sync + display_on + vblank_start"]:::logic
            HCNT --> SYNC
            VCNT --> SYNC
        end

        %% ----- cell select -----
        SEL["cell select<br/>col = hpos / CELL_W<br/>row = vpos / CELL_H"]:::glue

        %% ----- Game of Life core -----
        subgraph CORE["u_core : golchip_core (golchip.v)  N=4, W=2"]
            direction TB
            SEQ["golchip_sequencer<br/>step edge -> 2^speed gens<br/>starts on vblank_start<br/>12-cycle routine<br/>-> ld, shift_en, commit, busy"]:::logic
            GRID["golchip_grid : 4x4 golchip_cell<br/>serial snake load chain<br/>Life rule per cell<br/>-> cells 15:0"]:::logic
            MUX["golchip_readmux<br/>cell_bit = cells row*4+col"]:::logic
            SEQ -->|ld, shift_en, commit| GRID
            GRID -->|cells 15:0| MUX
        end

        %% ----- renderer + output register -----
        REND["renderer<br/>cell_bit + grid separators<br/>-> r,g,b (2 bits each)"]:::glue
        OREG["output register (uo_reg)<br/>pack R/G/B + hsync/vsync"]:::logic

        %% connections inside top
        DEC -->|load_en, load_data, step, speed| CORE
        RST -->|reset| VT
        VT -->|hpos, vpos| SEL
        VT -->|vblank_start| SEQ
        VT -->|hpos, vpos| REND
        VT -->|display_on, hsync, vsync| REND
        SEL -->|row, col| MUX
        MUX -->|cell_bit| REND
        REND -->|r, g, b| OREG
        VT -->|hsync, vsync| OREG
    end

    %% ===== pin wiring =====
    CLK --> VT
    CLK --> CORE
    CLK --> OREG
    RSTN --> RST
    RSTN --> CORE
    UIIN --> DEC
    OREG --> UOOUT

    %% uio pins tied off
    UIOO([uio_out = 0<br/>uio_oe = 0]):::pin
    TOP -.unused.-> UIOO

    classDef pin fill:#cfe0ff,stroke:#2d5bbf,color:#0b1b3a,stroke-width:2px;
    classDef logic fill:#d6f5df,stroke:#2e8b57,color:#0b2b17,stroke-width:2px;
    classDef glue fill:#fdeccd,stroke:#c9881f,color:#3a2606,stroke-width:2px;
